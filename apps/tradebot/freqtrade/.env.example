# Copy to .env and fill in. .env is ignored by git.
# A SECOND Telegram bot (make one more with /newbot in @BotFather): one bot token cannot serve
# TradeBot's webhook and freqtrade's polling at the same time.
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=
# run-windows.ps1 fills this in by itself: send the bot any message first, then start it.
FREQTRADE__TELEGRAM__CHAT_ID=
# FreqUI login (any long random strings).
FREQTRADE__API_SERVER__ENABLED=true
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
# Optional, OFF while empty: send the twin's numbers to TradeBot's server once a minute, so the
# twin's bot can show them in Telegram (see README, "Telegram through TradeBot's server").
# On an office network that blocks Telegram, ask whether that is allowed before filling this in.
TWIN_REPORT_KEY=
# Only when TradeBot's server is not at its usual address:
# TWIN_REPORT_URL=https://trade-bot.juw12.workers.dev/v1/twin/report
