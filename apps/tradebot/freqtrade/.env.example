# Copy to .env and fill in. .env is ignored by git.
# A SECOND Telegram bot (make one more with /newbot in @BotFather): one bot token cannot serve
# TradeBot's webhook and freqtrade's polling at the same time.
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
# FreqUI login (any long random strings).
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
