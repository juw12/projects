# TradeBot's MetaTrader 5 bridge. Copy this file to .env (git ignores .env) and fill it in.
# The bridge is OFF while MT5_BRIDGE_KEY is empty. DEMO ACCOUNTS ONLY.

# The key that POST /v1/mt5/setup gave you, once. Treat it like a password.
MT5_BRIDGE_KEY=

# TradeBot's server. Change it only for your own deploy. It must start with https://
# MT5_BRIDGE_URL=https://trade-bot.juw12.workers.dev

# How your broker names the coins, when it is not BTCUSD, ETHUSD, SOLUSD:
# MT5_SYMBOLS=BTCUSDT=Bitcoin,ETHUSDT=Ethereum
# Or one ending that every symbol carries at your broker (BTCUSD.m -> .m):
# MT5_SYMBOL_SUFFIX=

# Most copies open at the same time, 1 to 10.
# MT5_MAX_OPEN=3
