# TradeBot's Indodax sender. Copy this file to .env (git ignores .env) and fill it in.
# The sender is OFF while INDODAX_BRIDGE_KEY is empty. PRACTICE BY DEFAULT: pretend money.

# The key that POST /v1/indodax/setup gave you, once. Treat it like a password.
INDODAX_BRIDGE_KEY=

# TradeBot's server. Change it only for your own deploy. It must start with https://
# INDODAX_BRIDGE_URL=https://trade-bot.juw12.workers.dev

# One order, in whole rupiah, 20000 to 500000.
# INDODAX_ORDER_IDR=50000

# Most copies open at the same time, 1 to 3.
# INDODAX_MAX_OPEN=2

# The sender's own stop: a copy is sold when its price falls this many percent below what was
# paid, 1 to 20. It only works while this PC is on and the sender is running.
# INDODAX_STOP_PERCENT=8

# Only copy these coins (empty means every coin TradeBot holds that Indodax trades in rupiah).
# INDODAX_COINS=btc,eth

# A proxy for the calls to TradeBot and Indodax, when your network needs one.
# HTTPS_PROXY=http://localhost:3128

# ---------------------------------------------------------------------------------------------
# REAL MONEY. Leave everything below commented out for practice. Read README.md first.
#
# Real orders need all three together: the mode, the confirm sentence typed out exactly as the
# README gives it, and an API key. Make the key at Indodax with "view" and "trade" ONLY, with
# withdrawals OFF. The key works for --check as soon as it is here, even in practice mode.
#
# INDODAX_API_KEY=
# INDODAX_API_SECRET=
# INDODAX_MODE=real
# INDODAX_REAL_CONFIRM=
