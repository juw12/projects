# Copy to .env and fill in.
# Telegram bot: talk to @BotFather on Telegram, send /newbot, copy the token.
# Chat ID: talk to @userinfobot or @getidsbot to get your numeric chat ID.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading universe (comma-separated). Default = symbols ROBUST across all 3 windows in sweep_long.py.
# BTC was dropped — losing in every window tested.
SYMBOLS=XRPUSDT,DOGEUSDT,AVAXUSDT

# Candle timeframe: 1h, 4h, 1d (4h recommended for swing).
TIMEFRAME=4h

# Poll interval in seconds (how often to re-check). 14400 = 4h.
POLL_INTERVAL=14400

# Paper trading starting balance (USD).
PAPER_BALANCE=1000

# Risk per trade as fraction of balance (0.02 = 2%).
RISK_PER_TRADE=0.02

# Logs and ledger live here.
LEDGER_FILE=./paper_trades.csv

# ----------------------------------------------------------------------
# Live trading (OPT-IN, OFF by default). Remove the leading '#' to enable.
# Read executor.py and README.md before flipping LIVE_TRADING to true.
# ----------------------------------------------------------------------
# LIVE_TRADING=false
# USE_TESTNET=true
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# MAX_POSITION_USD=200
# MAX_DAILY_LOSS_USD=50
# EXECUTOR_KILL_SWITCH=false
