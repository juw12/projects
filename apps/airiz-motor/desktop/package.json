{
  "name": "airiz-console-desktop",
  "version": "1.11.18",
  "description": "AIRIZ offline motor, serial, camera and macro control console for Windows",
  "productName": "AIRIZ Console",
  "author": "AIRIZ",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "test:packaged": "node tests/native-smoke.cjs",
    "test:hardware": "node tests/hardware-remote.cjs",
    "test:owner-browser": "node tests/owner-setup-browser.cjs",
    "test:owner-packaged": "node tests/owner-setup-packaged.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright-core": "1.60.0"
  },
  "build": {
    "appId": "com.airiz.console",
    "productName": "AIRIZ Console",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "security.cjs",
      "serial-chooser.cjs",
      "device-grants.cjs",
      "update-controller.cjs",
      "power-keeper.cjs",
      "power-plan.cjs",
      "assets/app.ico",
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "!README.md",
          "!updates/**"
        ]
      }
    ],
    "win": {
      "icon": "assets/app.ico",
      "executableName": "AIRIZ Console",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIRIZ Console",
      "uninstallDisplayName": "AIRIZ Console",
      "deleteAppDataOnUninstall": false,
      "artifactName": "AIRIZ-Console-Setup-${version}-x64.exe"
    },
    "portable": {
      "artifactName": "AIRIZ-Console-Portable-${version}-x64.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://juw12.github.io/projects/airiz-motor/updates/windows/"
      }
    ],
    "protocols": [
      {
        "name": "AIRIZ Console",
        "schemes": [
          "airiz-console"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
