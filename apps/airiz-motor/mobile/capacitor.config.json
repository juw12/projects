{
  "appId": "io.github.juwpegatron.airiz.mobile",
  "appName": "AIRIZ Mobile",
  "webDir": "www",
  "backgroundColor": "#0d1117",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Scanning for your device…",
        "cancel": "Cancel",
        "availableDevices": "Bluetooth devices",
        "noDeviceFound": "No BLE device found. Enable device Bluetooth from the USB console first."
      }
    },
    "LiveUpdate": {
      "appId": "airiz-motor-mobile",
      "defaultChannel": "production",
      "autoUpdateStrategy": "background",
      "readyTimeout": 10000,
      "autoBlockRolledBackBundles": true,
      "autoDeleteBundles": true,
      "httpTimeout": 60000,
      "serverDomain": "https://releases.airiz.example"
    }
  }
}
