# Buddy — environment variables
#
# Copy this file to `.env` and fill in values from your Supabase project.
# Never commit `.env` — it is gitignored.

# Supabase project URL (find it in Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon key (safe to ship in the renderer; RLS still enforces auth)
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Web Push VAPID keys (generate with `npx web-push generate-vapid-keys`)
# Required for push notifications when the app is closed.
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
