# Lingua settings for this laptop. Rename this file to lingua.env (same folder as Lingua.exe)
# or copy it to %APPDATA%\lingua\lingua.env. Real environment variables win over this file.

# Your MaaS gateway (ask whoever gave you the API key):
LINGUA_OCR_BASE_URL=
LINGUA_LLM_BASE_URL=
LINGUA_LLM_MODEL=
LINGUA_LLM_MODELS=
LINGUA_GATEWAY_MODEL_PREFIX=

# API key. Leave empty if this laptop already has it in %USERPROFILE%\.config\opencode\opencode.json
# or in the MAAS_API_KEY environment variable. Anyone who can read this file can use the key.
MAAS_API_KEY=
