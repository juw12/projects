# Copy these into your host's environment settings (Render → Environment).
PUBLIC_URL=https://your-app.onrender.com
DATA_DIR=/var/data

# Models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Your own email gets Pro for free (comma-separated)
ADMIN_EMAILS=you@example.com

# Plans and limits (optional; defaults shown)
PRO_PRICE_LABEL=$20 / month
FREE_DAILY_MESSAGES=30
PRO_DAILY_MESSAGES=500
PRO_MONTHLY_BUDGET_USD=8
PRO_MAX_OUTPUT_PRICE_PER_MTOK=30
