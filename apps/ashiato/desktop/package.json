{
  "name": "ashiato-desktop",
  "version": "0.2.0",
  "description": "Ashiato: a cozy photo diary, walking map and weather town",
  "productName": "Ashiato",
  "author": "juw12",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "smoke": "node scripts/smoke.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright-core": "1.60.0"
  },
  "build": {
    "appId": "io.github.juw12.ashiato",
    "productName": "Ashiato",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      {
        "from": "../web/app",
        "to": "app",
        "filter": ["**/*", "!**/*.md"]
      }
    ],
    "win": {
      "icon": "../web/app/icons/icon-1024.png",
      "executableName": "Ashiato",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ashiato",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Ashiato-Setup-x64.exe"
    },
    "portable": {
      "artifactName": "Ashiato-Portable-x64.exe"
    },
    "mac": {
      "icon": "../web/app/icons/icon-1024.png",
      "category": "public.app-category.lifestyle",
      "target": ["dmg"],
      "identity": null,
      "artifactName": "Ashiato-mac.${ext}"
    },
    "dmg": {
      "title": "Ashiato"
    }
  }
}
