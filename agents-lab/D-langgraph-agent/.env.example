# Optional settings for the LangGraph starter agent.
# Copy to `.env` (or just set these in your shell).

# Ollama model to use (default: qwen3:8b — tool-capable, needed for the tools).
# Models already present on this machine: hermes3:latest, qwen3:8b, qwen3-32k
# Note: hermes3 does NOT support tool calling; qwen3:8b does.
OLLAMA_MODEL=qwen3:8b

# Ollama server (default). Leave unset for local default.
# OLLAMA_HOST=http://127.0.0.1:11434
