# ============================================
# OpenForge — Environment Variables
# Copy to .env and fill in real values
# ============================================

# --- Postgres ---
DATABASE_URL=postgres://openforge:openforge@localhost:5432/openforge

# --- Cloudflare R2 (primary object storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=openforge-packs
# S3 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- AWS S3 (DR target) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_DR_BUCKET=openforge-packs-dr

# --- Better Auth ---
BETTER_AUTH_SECRET=  # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8787

# --- Auth crypto (TOTP secret encryption at rest) ---
# 32 bytes hex — generates AES-256-GCM key for encrypting secrets in Postgres
# Generate: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

# --- Git transport ---
# Local path where bare git repos live on disk (each at <REPO_ROOT>/<owner>/<repo>.git)
REPO_ROOT=/var/lib/openforge/repos
# On Windows dev: REPO_ROOT=C:\\openforge\\repos

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8787
WEB_PORT=3000

# --- API (Hono) ---
API_PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Git binary ---
GIT_BINARY_PATH=/usr/bin/git  # or `where git` on Windows

# --- CI sandbox ---
GOMPLATE_VERSION=v4.1.1
RUNSC_VERSION=20231219.0
