# Required: free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_key_here

# Optional: override the model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: email notification via Gmail SMTP (requires 2FA + App Password).
# Leave blank to skip — GitHub will still commit the spec to your repo, and
# you'll get a notification from GitHub if you watch the repo.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_APP_PASSWORD=your_16_char_app_password
# NOTIFY_EMAIL=you@gmail.com
