# Respark - environment template
# Copy to .env and fill in real values.

# REQUIRED in production - long random string for signing session cookies.
RESPARK_SECRET=replace-me-with-a-long-random-string

# REQUIRED - public URL the app is served from.
RESPARK_BASE_URL=http://localhost:8000

# OPTIONAL - SMTP for real email delivery.
RESPARK_SMTP_HOST=
RESPARK_SMTP_PORT=587
RESPARK_SMTP_USER=
RESPARK_SMTP_PASS=
RESPARK_SMTP_FROM=Respark <hello@yourdomain.com>

# OPTIONAL - OpenAI key for AI-personalized messages.
RESPARK_OPENAI_API_KEY=

# OPTIONAL - set to 0 to disable public signup.
RESPARK_ALLOW_SIGNUP=1

# OPTIONAL - Stripe for real payments.
RESPARK_STRIPE_SECRET_KEY=
RESPARK_STRIPE_PUBLISHABLE_KEY=
RESPARK_STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (from your Stripe dashboard).
RESPARK_STRIPE_PRICE_STARTER=
RESPARK_STRIPE_PRICE_GROWTH=

# Bridge mode (Industrial Connect)
# Operator logins (comma separated). If empty, the first registered account is the operator.
RESPARK_OPERATOR_EMAILS=
# Public name of your bridge / hub.
RESPARK_HUB_NAME=Titian

# Bridge: your WhatsApp (digits incl. country code). Via-bridge portals and the hub hand chats to you.
RESPARK_OPERATOR_WHATSAPP=

# Bridge: terms a company accepts before it sees a requester's contact (have a lawyer review this).
RESPARK_INTRO_TERMS=

# Bridge: reply/bounce detection for outreach (IMAP). Host defaults to the SMTP host
# with smtp->imap (e.g. smtp.gmail.com -> imap.gmail.com); user/pass default to SMTP ones.
RESPARK_IMAP_HOST=
RESPARK_IMAP_USER=
RESPARK_IMAP_PASS=
# Minutes between inbox checks.
RESPARK_IMAP_EVERY=15

# Bridge: FX rates to USD for supplier quote comparison, e.g. CNY=0.138,IDR=0.000062,EUR=1.08
RESPARK_FX=

# Bridge: optional AI reading of messy supplier quotes (uses RESPARK_OPENAI_API_KEY above).
# Only runs when the operator ticks "Read with AI" on a quote; the quote text goes to this provider.
RESPARK_OPENAI_BASE_URL=
RESPARK_QUOTE_MODEL=gpt-4o-mini
