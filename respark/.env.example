# Respark - environment template
# Copy to .env and fill in real values.

# REQUIRED in production - long random string for signing session cookies.
RESPARK_SECRET=replace-me-with-a-long-random-string

# REQUIRED - public URL the app is served from.
RESPARK_BASE_URL=http://localhost:8000

# OPTIONAL - SMTP for real email delivery.
RESPARK_SMTP_HOST=
RESPARK_SMTP_PORT=587
RESPARK_SMTP_USER=
RESPARK_SMTP_PASS=
RESPARK_SMTP_FROM=Respark <hello@yourdomain.com>

# OPTIONAL - OpenAI key for AI-personalized messages.
RESPARK_OPENAI_API_KEY=

# OPTIONAL - set to 0 to disable public signup.
RESPARK_ALLOW_SIGNUP=1

# OPTIONAL - Stripe for real payments.
RESPARK_STRIPE_SECRET_KEY=
RESPARK_STRIPE_PUBLISHABLE_KEY=
RESPARK_STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (from your Stripe dashboard).
RESPARK_STRIPE_PRICE_STARTER=
RESPARK_STRIPE_PRICE_GROWTH=
